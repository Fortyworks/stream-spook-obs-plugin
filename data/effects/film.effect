// 古い映画（セピア）と黒澤モード（モノクロ映画）。
//
// 色の付け方だけが違い、フィルムの乱れ（粒子・傷・ゴミ・ちらつき・揺れ）は
// 同じなので、technique を 2 つ持って共有する。
//
// 乱数は全部「時間と座標のハッシュ」で作る。テクスチャを持たずに済むし、
// 設定画面のプレビューと配信画面で同じ絵になる。

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_size;   // 対象の大きさ（px）
uniform float time;       // 経過秒（speed 込み）
uniform float strength;   // 0..1  効果ぜんたいの混ぜ具合
uniform float fade;       // 0..1  黒の持ち上げ（セピア）
uniform float contrast;   // 0.5..3（黒澤）
uniform float blacks;     // 0..1  黒つぶし（黒澤）
uniform float vignette;   // 0..1  周辺の暗さ
uniform float damage;     // 0..1  乱れの総量（アニメーション済み）
uniform float grain;      // 0..1  粒子
uniform float scratches;  // 0..1  縦の傷
uniform float dust;       // 0..1  ゴミ
uniform float flicker;    // 0..1  明るさのちらつき
uniform float jitter;     // 0..1  コマの揺れ

sampler_state textureSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

// ---- 乱数 ----

float hash11(float p)
{
	p = frac(p * 0.1031);
	p *= p + 33.33;
	p *= p + p;
	return frac(p);
}

float hash21(float2 p)
{
	float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
	p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 33.33);
	return frac((p3.x + p3.y) * p3.z);
}

// ---- 色 ----

float3 tone_sepia(float3 c)
{
	float3 s;
	s.r = dot(c, float3(0.393, 0.769, 0.189));
	s.g = dot(c, float3(0.349, 0.686, 0.168));
	s.b = dot(c, float3(0.272, 0.534, 0.131));
	// 退色: 黒が浮いてコントラストが落ちる
	s = lerp(s, s * 0.75 + 0.18, fade);
	return s;
}

float3 tone_kurosawa(float3 c)
{
	// 赤フィルタ寄りの白黒。空が沈み、肌が浮く 1950 年代の見え方に寄せる
	float l = dot(c, float3(0.45, 0.45, 0.10));
	l = (l - 0.5) * contrast + 0.5;
	// 黒つぶし: 暗部を切り落として残りを引き伸ばす
	float cut = blacks * 0.35;
	l = saturate((l - cut) / max(1.0 - cut, 0.001));
	// 緩い S 字で肩と足を丸める
	float s = l * l * (3.0 - 2.0 * l);
	l = lerp(l, s, 0.35);
	return float3(l, l, l);
}

// ---- 乱れ ----

// 縦の傷 1 本ぶん。seg が変わるたびに別の場所へ出直す
float scratch_line(float2 uv, float frame, float fi, float amt)
{
	float seg = floor(time * (0.6 + fi * 0.23) + fi * 7.0);
	float present = step(1.0 - scratches * amt * 0.6, hash11(seg * 3.1 + fi * 17.0));
	float x0 = hash11(seg * 5.7 + fi * 29.0);
	float x = x0 + (hash11(frame * 0.91 + fi * 11.0) - 0.5) * 0.006;
	float d = abs(uv.x - x) * uv_size.x;
	float ln = (1.0 - smoothstep(0.0, 1.5, d)) * present;
	float bright = step(0.5, hash11(seg * 2.3 + fi)) * 2.0 - 1.0;
	return bright * ln;
}

float3 film_damage(float3 c, float2 uv, float2 px, float frame, float amt)
{
	// 粒子: ピクセルごと・コマごとに変わる
	float g = hash21(floor(px * 0.5) + frame * 7.13) - 0.5;
	c += g * grain * amt * 0.22;

	// ちらつき: コマごとの明るさのむら
	float fl = (hash11(frame * 1.37 + 0.5) - 0.5) * flicker * amt * 0.35;
	c *= 1.0 + fl;

	// 傷: 3 本まで
	float sc = scratch_line(uv, frame, 0.0, amt) + scratch_line(uv, frame, 1.0, amt) +
		   scratch_line(uv, frame, 2.0, amt);
	c += sc * 0.55 * scratches * amt;

	// ゴミ: まばらな黒い点。24px のマス目ごとに、コマごとの確率で 1 つ出す
	float2 cell = floor(px / 24.0);
	float h = hash21(cell + frame * 3.7);
	float p = dust * amt * 0.06;
	if (h < p) {
		float2 jitterc = float2(hash21(cell * 1.3 + frame), hash21(cell * 2.1 + frame * 1.7));
		float2 center = (cell + jitterc) * 24.0;
		float r = 1.0 + hash21(cell + frame * 0.5) * 3.0;
		float dd = length(px - center);
		float speck = 1.0 - smoothstep(r * 0.5, r, dd);
		c *= 1.0 - speck * 0.85;
	}
	return c;
}

float2 frame_jitter(float frame, float amt)
{
	return (float2(hash11(frame * 1.7 + 3.0), hash11(frame * 2.9 + 5.0)) - 0.5) * jitter * amt * 0.012;
}

float edge_darken(float2 uv)
{
	float2 d = uv - 0.5;
	float v = smoothstep(0.35, 0.95, length(d) * 1.4142);
	return 1.0 - v * vignette;
}

// ---- 本体 ----

float4 film_common(float2 uv_in, float mode)
{
	// コマ番号。ハッシュに入れる数が大きくなりすぎないよう、適当なところで折り返す
	float frame = fmod(floor(time * 24.0), 4096.0);
	float amt = damage;
	float2 uv = uv_in + frame_jitter(frame, amt);
	float2 px = uv_in * uv_size;

	float4 src = image.Sample(textureSampler, uv);
	float3 c = (mode > 0.5) ? tone_kurosawa(src.rgb) : tone_sepia(src.rgb);
	c = film_damage(c, uv, px, frame, amt);
	c *= edge_darken(uv_in);

	float4 orig = image.Sample(textureSampler, uv_in);
	return float4(lerp(orig.rgb, saturate(c), strength), src.a);
}

float4 PSSepia(VertData v_in) : TARGET
{
	return film_common(v_in.uv, 0.0);
}

float4 PSKurosawa(VertData v_in) : TARGET
{
	return film_common(v_in.uv, 1.0);
}

technique Sepia
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSSepia(v_in);
	}
}

technique Kurosawa
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSKurosawa(v_in);
	}
}
